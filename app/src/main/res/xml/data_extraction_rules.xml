<?xml version="1.0" encoding="utf-8"?>
<!-- Ni sauvegarde dans le nuage ni transfert d'appareil à appareil (Android 12+ ; allowBackup="false" ne couvre pas
     le transfert) : un animal ne se copie pas — il voyage (même identifiant sur deux téléphones sinon). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
